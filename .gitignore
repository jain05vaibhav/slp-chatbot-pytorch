# ==============================================================================
# VoxAI Project .gitignore
# ==============================================================================

# --- Environment & Secret Credentials ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python Caches & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Python Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# --- Node / Frontend Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Machine Learning Weights & Large Model Dumps ---
*.pth
*.pt
*.bin
*.onnx
*.safetensors
data/*.pth

# --- Screen Recordings & Large Media Artifacts ---
*.mp4
*.webp
*.mov
*.avi
*.mkv
voxai_chatbot_demo.*

# --- PDF Documents & Compiled Reports ---
*.pdf
project_report.pdf
report.pdf
generate_pdf_report.py
generate_pdf*.py

# --- LaTeX Compilation Auxiliary Files ---
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lot
*.lof
*.idx
*.ilg
*.ind
*.bbl
*.blg
*.brf
*.out
*.nav
*.snm
*.vrb

# --- OS-specific & Editor Cache Files ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Temporary & Scratch Directories ---
scratch/
static_legacy_backup/
.tempmediaStorage/
*.tmp
*.bak
*.swp
record_chatbot_demo.py